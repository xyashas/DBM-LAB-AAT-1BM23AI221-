#Balanced Brackets
def is_balanced(s):
    stack = []
    brackets = {')': '(', '}': '{', ']': '['}
    for char in s:
        if char in brackets.values():
            stack.append(char)
        elif char in brackets.keys():
            if stack and stack[-1] == brackets[char]:
                stack.pop()
            else:
                return "NO"
    return "YES" if not stack else "NO"

s = "{[()]}"
print(is_balanced(s))  
